PORT=8000
NODE_ENV=development

# Frontend Application URLs
PUBLIC_APP_URL=http://localhost:5000
SELLER_APP_URL=http://localhost:5140
ADMIN_APP_URL=http://localhost:5174
CLIENT_URL=http://localhost:5000,http://localhost:5140,http://localhost:5174,http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kisanova_db

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# App URL for Reset Links (Defaults to origin or PUBLIC_APP_URL)
APP_URL=http://localhost:5000

# Cloudinary (Optional, falls back to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kisanova_media

# Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Kisanova

# Database Seeding Demo Passwords (Optional customization for local seed script)
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SELLER_PASSWORD=Seller@123456
SEED_BUYER_PASSWORD=Buyer@123456

# Rate Limiting Configuration (Configurable Thresholds & Backoff)
RATE_LIMIT_ENABLED=true
# Public Endpoints (Moderate)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
# Authenticated User Actions (Looser, Per-User ID)
RATE_LIMIT_AUTHED_WINDOW_MS=900000
RATE_LIMIT_AUTHED_MAX=1500
# Authentication Endpoints (Stricter, Per-IP & Per-Account + Exponential Backoff)
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_AUTH_ACCOUNT_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=2000
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=900000
# Sensitive Auth Sub-routes
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_RESEND_VERIFICATION_WINDOW_MS=60000
RATE_LIMIT_RESEND_VERIFICATION_MAX=2
RATE_LIMIT_VERIFY_EMAIL_WINDOW_MS=900000
RATE_LIMIT_VERIFY_EMAIL_MAX=10

