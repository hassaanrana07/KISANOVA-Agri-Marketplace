PORT=8000
NODE_ENV=development

# Frontend Application URLs
PUBLIC_APP_URL=http://localhost:5000
SELLER_APP_URL=http://localhost:5140
ADMIN_APP_URL=http://localhost:5174
CLIENT_URL=http://localhost:5000,http://localhost:5140,http://localhost:5174,http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kisanova_db

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# App URL for Reset Links (Defaults to origin or PUBLIC_APP_URL)
APP_URL=http://localhost:5000

# Cloudinary (Optional, falls back to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kisanova_media
