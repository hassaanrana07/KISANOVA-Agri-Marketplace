# =======================================================
# KISANOVA ROOT ENVIRONMENT TEMPLATE
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kisanova_db
DB_PORT=3306

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Payment Service Configuration
# Choices: kisanova_sandbox | stripe | bank_transfer
PAYMENT_PROVIDER=kisanova_sandbox
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET=your_payment_webhook_secret
BANK_ACCOUNT_NAME=Kisanova Agricultural Escrow LLC
BANK_IBAN=PK36MEZN0001234567890123
BANK_SWIFT=MEZNPKKA

# Cloudinary Storage Configuration (Optional, local upload fallback supported)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=kisanova_media

# Frontend API URL
VITE_API_URL=http://localhost:5000/api
